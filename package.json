{
  "name": "erp-moveis-colchoes-mvp",
  "version": "0.2.0",
  "private": true,
  "description": "ERP MVP Fase 1 para rede de 2 lojas de moveis e colchoes.",
  "scripts": {
    "start": "node src/server.js",
    "db:migrate": "node migrate-json-to-pg.js",
    "db:dry-run": "node migrate-json-to-pg.js --dry-run",
    "db:check": "node src/db-check.js",
    "test:pg": "set USE_POSTGRES=true&& node --test --test-concurrency=1 tests/*.test.js",
    "db:smoke": "node src/test-pg.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "resend": "^6.28.0"
  },
  "engines": {
    "node": ">=20"
  }
}
